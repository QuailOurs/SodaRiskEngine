# =============================================================================
# 项目 .gitignore 文件
# =============================================================================

# IDE 文件
.idea/
*.iml
*.iws
*.ipr
.vscode/
.settings/
.project
.classpath
.factorypath

# 构建输出
target/
build/
dist/
coverage/
out/
.cache/
.parcel-cache/
.sass-cache/
.turbo/
.vite/
.eslintcache
.stylelintcache
*.tsbuildinfo
*.class
*.jar
*.war
*.ear

# 日志文件
*.log
logs/
runtime-logs/
*.pid

# 操作系统文件
.DS_Store
Thumbs.db
desktop.ini

# Node.js
node_modules/
.npm-cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python 工具缓存
__pycache__/
.pytest_cache/
*.py[cod]

# 密钥文件（本地开发用）
secrets.properties
secrets-local.properties
*.env
.env.local
.env.*.local

# Gradle
.gradle/
gradle/wrapper/gradle-wrapper.jar

# 临时文件
*.tmp
*.bak
*.swp
*.swo
*~
