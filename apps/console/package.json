{
  "name": "soda-console",
  "version": "0.1.0",
  "description": "Soda rule engine management console",
  "author": "Soda Contributors",
  "private": true,
  "scripts": {
    "dev": "vue-cli-service serve --open",
    "build": "vue-cli-service build",
    "lint": "vue-cli-service lint",
    "test:unit": "vue-cli-service test:unit --require tests/unit/setup.js",
    "test:unit:coverage": "vue-cli-service test:unit --require tests/unit/setup.js --coverage",
    "test:e2e": "vue-cli-service test:e2e"
  },
  "dependencies": {
