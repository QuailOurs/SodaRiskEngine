    "countup": "^1.8.2",
    "cropperjs": "^1.5.6",
    "dayjs": "^1.8.23",
    "echarts": "^4.7.0",
    "eslint": "^6.8.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^4.2.1",
    "eslint-plugin-standard": "^4.0.1",
    "eslint-plugin-vue": "^6.2.2",
    "html2canvas": "^1.0.0-rc.5",
    "iview": "^3.5.4",
    "iview-area": "^1.5.17",
    "js-cookie": "^2.2.1",
    "moment": "^2.29.1",
    "simplemde": "^1.11.2",
    "sortablejs": "^1.10.2",
    "tree-table-vue": "^1.1.0",
